# Operator API + contract tooling (hardhat deploy / seed run from this same image).
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY contracts/package.json contracts/
COPY operator/package.json operator/
COPY apps/wallet/package.json apps/wallet/
COPY apps/pos/package.json apps/pos/
COPY apps/lumbung/package.json apps/lumbung/
RUN npm ci --include=dev --no-audit --no-fund
COPY packages ./packages
COPY contracts ./contracts
COPY operator ./operator
RUN cd contracts && npx hardhat compile
WORKDIR /app/operator
EXPOSE 4600
CMD ["npx", "tsx", "src/server.ts"]
