# Builds the three front-ends and serves them by hostname from one Caddy container (internal, no TLS).
FROM node:22-bookworm-slim AS build
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY contracts/package.json contracts/
COPY operator/package.json operator/
COPY apps/wallet/package.json apps/wallet/
COPY apps/pos/package.json apps/pos/
COPY apps/lumbung/package.json apps/lumbung/
RUN npm ci --include=dev --no-audit --no-fund
COPY packages ./packages
COPY apps ./apps
RUN npm -w apps/wallet run build && npm -w apps/pos run build && npm -w apps/lumbung run build

FROM caddy:2-alpine
COPY deploy/web.Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/wallet/dist /srv/wallet
COPY --from=build /app/apps/pos/dist /srv/pos
COPY --from=build /app/apps/lumbung/dist /srv/lumbung
